# Copy to .env and adjust. Every setting is optional; defaults run everything on one laptop.

# --- first administrator (only used when the database is empty)
VMS_ADMIN_USERNAME=admin
# VMS_ADMIN_PASSWORD=choose-a-strong-one   # if unset, a random one is written to data/initial_admin_password.txt

# --- security (leave empty to auto-generate data/secret.key)
# VMS_SECRET_KEY=
VMS_JWT_TTL_MINUTES=480
# behind a reverse proxy (nginx / ALB), list its address so X-Forwarded-For is trusted for rate limiting
# VMS_TRUSTED_PROXIES=["127.0.0.1"]

# --- upload limits (MB): videos, dataset zips (and their unzipped size), model weights
# VMS_MAX_VIDEO_UPLOAD_MB=4096
# VMS_MAX_DATASET_UPLOAD_MB=4096
# VMS_MAX_DATASET_UNZIPPED_MB=16384
# VMS_MAX_WEIGHTS_UPLOAD_MB=1024

# --- time zone for schedules ("closed after 20:00") and hourly statistics
VMS_TIMEZONE=Asia/Kolkata

# --- database: SQLite file by default; PostgreSQL (e.g. AWS RDS) in the cloud
# VMS_DATABASE_URL=postgresql+psycopg://vms:password@localhost:5432/vms

# --- object storage: local folder by default; S3 (or MinIO) in the cloud
VMS_STORAGE_BACKEND=local
# VMS_STORAGE_BACKEND=s3
# VMS_S3_BUCKET=my-vms-bucket
# VMS_S3_REGION=ap-south-1
# VMS_S3_ENDPOINT_URL=http://localhost:9000     # only for MinIO

# --- workers
VMS_EMBEDDED_WORKERS=true      # false when workers run as separate processes (python -m app.workers.run)
VMS_WORKER_GROUP=default
VMS_DEVICE=auto                # auto | cpu | cuda:0
VMS_INFERENCE_BATCH_SIZE=4
# VMS_REDIS_URL=redis://localhost:6379/0     # needed for live view when workers run separately

# --- retention (days)
VMS_RETENTION_RECORDINGS_DAYS=7
VMS_RETENTION_EVIDENCE_DAYS=90
VMS_RETENTION_TRACKS_DAYS=30

# --- alerts: POST a JSON message to this URL for incidents at or above the severity
# VMS_NOTIFY_WEBHOOK_URL=https://example.com/hooks/vms
VMS_NOTIFY_MIN_SEVERITY=medium

# --- production
# VMS_ENVIRONMENT=production     # JSON logs
# VMS_CORS_ORIGINS=["https://vms.example.edu"]
